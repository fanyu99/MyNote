	"nodes":[
		{"id":"0abe78d32edc2f07","type":"file","file":"仓库管理系统/日程实施计划/白板/数据库相关模块/2026-07-26 Day11.md","x":-151,"y":-181,"width":591,"height":1021,"color":"1"},
		{"id":"f202e9fe2d0cfce0","type":"text","text":"# findById函数相关的调用流程\n\n```mermaid\nflowchart TD\n    classDef caller fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#000\n    classDef step fill:#ffffff,stroke:#546e7a,color:#000\n    classDef async fill:#e8f5e9,stroke:#2e7d32,color:#000\n    classDef callback fill:#fce4ec,stroke:#c62828,color:#000\n    classDef note fill:#fff9c4,stroke:#f9a825,stroke-dasharray:5 5,color:#000\n\n    Caller[\"调用方 (ProductService)\"]:::caller\n\n    subgraph P1[\"①-⑤ 提交阶段\"]\n        direction TB\n        A[\"① findById(id, owner, callback)<br/>校验参数有效性 + 快速失败\"]:::step\n        B[\"② 构建 DatabaseStatement<br/>SQL: SELECT ... WHERE id = :id\"]:::step\n        C[\"③ 构建 DatabaseTask<br/>requestId(QUuid), type=Single\"]:::step\n        D[\"④ 提交到 DatabaseExecutor<br/>executor_.submitTask(task)\"]:::step\n        E[\"⑤ 注册回调到 pending_<br/>key: taskId → value: PendingRequest\"]:::step\n        A --> B --> C --> D --> E\n    end\n\n    N[\"⚠️ findById 返回, 任务在后台执行\"]:::note\n\n    subgraph P2[\"⑥-⑦ 异步执行阶段\"]\n        direction TB\n        F[\"⑥ 后台线程执行 SQL<br/>取出任务 → 查询 → DatabaseResult\"]:::async\n        G[\"⑦ 发出 taskFinished 信号<br/>emit taskFinished(result)\"]:::async\n        F --> G\n    end\n\n    subgraph P3[\"⑧-⑩ 回调处理阶段\"]\n        direction TB\n        H[\"⑧ onTaskFinished 触发<br/>查找 pending_ → 取出并移除<br/>检查 owner 存活\"]:::callback\n        I[\"⑨ 执行 lambda 回调<br/>失败→映射错误<br/>成功→mapProductRow\"]:::callback\n        J[\"⑩ 原始 callback 被调用<br/>收到 ProductOperationResult\"]:::callback\n        H --> I --> J\n    end\n\n    Caller --> A\n    E --> N\n    N --> F\n    G --> H","x":533,"y":-620,"width":387,"height":1920,"color":"2"},
		{"id":"545bd10ed8454854","type":"file","file":"仓库管理系统/系统核心架构/异步执行中的回调函数的传递链.md","x":1040,"y":160,"width":360,"height":600}
	],
